+// npm extracts tarball modes through the process umask, so a group-writable
+// umask (0002 is common) produces group-writable files. The server postinstall
+// refuses group/world-writable pinned binaries, which made a legitimate payload
+// uninstallable on those hosts. Install with the npm-standard umask instead of
+// weakening that check. Child processes inherit it.
+async function withInstallUmask<T>(run: () => Promise<T>): Promise<T> {
+  const previous = process.umask(0o022);
+  try {
+    return await run();
+  } finally {
+    process.umask(previous);
+  }
+}
