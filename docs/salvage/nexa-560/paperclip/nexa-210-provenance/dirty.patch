+export type GrantProvenanceBackfillStats = {
+  roleDefaultMarked: number;
+  /** Rows the table cannot classify. Deliberately counted, never guessed. */
+  unresolved: number;
+};
+
+/**
+ * Mark the provenance of grant rows written before the column existed.
+ *
+ * Only the decidable half is marked. A row is `role_default` when it has no
+ * granting human and its permission key is one some role confers -- that
+ * combination is unreachable for an explicit grant, because every explicit-grant
+ * writer records the actor, and unreachable for a non-role path, because no role
+ * seeds a key outside that set. This marks exactly the rows the demotion prune
+ * used to select by `granted_by_user_id IS NULL`, so the backfill changes no
+ * demotion outcome.
+ *
+ * The rest stay `unknown`, and that is the whole point of the third value. Those
+ * rows include both a permission somebody granted deliberately and a role default
+ * that a seeding path stamped with the granting human (board-claim, company-create,
+ * company-clone, and both member-permission write paths). The single row satisfies
+ * both readings, no query separates them, and choosing one silently either strips
+ * an intentional grant or leaves a demoted owner holding
+ * `users:manage_permissions`. That choice is an owner's to make, so the rows are
+ * counted and reported here rather than resolved by guesswork; `unknown` survives a
+ * demotion, which is the behaviour in place before this column existed.
+ *
+ * Idempotent: it only ever moves a row out of `unknown`.
+ */
+export async function backfillGrantProvenance(db: Db): Promise<GrantProvenanceBackfillStats> {
+  const roleDefaultKeys = allHumanRoleDefaultPermissionKeys();
+
+  const marked = await db
+    .update(principalPermissionGrants)
+    .set({ source: "role_default", updatedAt: new Date() })
+    .where(
+      and(
+        eq(principalPermissionGrants.source, "unknown"),
+        eq(principalPermissionGrants.principalType, "user"),
+        isNull(principalPermissionGrants.grantedByUserId),
+        inArray(principalPermissionGrants.permissionKey, roleDefaultKeys),
+      ),
+    )
+    .returning({ id: principalPermissionGrants.id });
+
+  const unresolvedRows = await db
+    .select({ id: principalPermissionGrants.id })
+    .from(principalPermissionGrants)
+    .where(eq(principalPermissionGrants.source, "unknown"));
+
+  return {
+    roleDefaultMarked: marked.length,
+    unresolved: unresolvedRows.length,
+  };
+}
