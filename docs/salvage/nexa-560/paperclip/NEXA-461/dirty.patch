+export const PAYLOAD_MARKER_VERSION = 1;
+export const PAYLOAD_MARKER_FILENAME = ".paperclip-managed-payload.json";
+
+/**
+ * Written into every payload the store activates. Pruning trusts this marker and
+ * nothing else: a payload staged by hand (or built against a scratch store and
+ * moved in) carries no matching marker, so the next install leaves it alone
+ * instead of deleting a build that was staged ahead of a restart window.
+ */
+export type PayloadMarker = {
+  schemaVersion: typeof PAYLOAD_MARKER_VERSION;
+  managedBy: "paperclipai";
+  installsRoot: string;
+  payloadPath: string;
+  source: InstallSource;
+  version: string;
+  installedAt: string;
+};
+
+function payloadMarkerPath(payloadPath: string): string {
+  return path.join(payloadPath, PAYLOAD_MARKER_FILENAME);
+}
+
+export function writePayloadMarker(
+  payloadPath: string,
+  record: Pick<InstallRecord, "source" | "version" | "installedAt">,
+  paths = resolveInstallStorePaths(),
+): void {
+  const marker: PayloadMarker = {
+    schemaVersion: PAYLOAD_MARKER_VERSION,
+    managedBy: "paperclipai",
+    installsRoot: path.resolve(paths.installsRoot),
+    payloadPath: path.resolve(payloadPath),
+    source: record.source,
+    version: record.version,
+    installedAt: record.installedAt,
+  };
+  writeFileAtomic(payloadMarkerPath(payloadPath), `${JSON.stringify(marker, null, 2)}\n`, 0o600);
+}
+
+export function readPayloadMarker(payloadPath: string): PayloadMarker | null {
+  try {
+    const value = JSON.parse(fs.readFileSync(payloadMarkerPath(payloadPath), "utf8")) as PayloadMarker;
+    if (
+      value?.schemaVersion !== PAYLOAD_MARKER_VERSION ||
+      value.managedBy !== "paperclipai" ||
+      typeof value.installsRoot !== "string" ||
+      typeof value.payloadPath !== "string"
+    ) {
+      return null;
+    }
+    return value;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * A payload belongs to this store only when its marker names both this store and
+ * this directory. A payload copied from another install store (the documented
+ * way to avoid a rebuild in the window) therefore stays foreign until the store
+ * activates it and rewrites the marker for its own path.
+ */
+export function isManagedPayload(
+  payloadPath: string,
+  paths = resolveInstallStorePaths(),
+): boolean {
+  const marker = readPayloadMarker(payloadPath);
+  return (
+    marker !== null &&
+    path.resolve(marker.installsRoot) === path.resolve(paths.installsRoot) &&
+    path.resolve(marker.payloadPath) === path.resolve(payloadPath)
+  );
+}
+
+export function markInstallPayloads(
+  manifest: InstallManifest,
+  paths = resolveInstallStorePaths(),
+): void {
+  for (const record of [manifest, ...manifest.previous]) {
+    if (!fs.existsSync(record.payloadPath)) continue;
+    writePayloadMarker(record.payloadPath, record, paths);
+  }
+}
